import { beforeEach, describe, expect, it, vi } from 'vitest'
const upstream = vi.hoisted(() => vi.fn(async () => new Response('<main>approved</main>', { headers: { 'Content-Type': 'text/html; charset=utf-8' } })))
vi.mock('vinext/server/fetch-handler', () => ({ default: { fetch: upstream } }))
import { createPreviewHandler } from './worker-preview'
const worker = createPreviewHandler({ fetch: upstream })
beforeEach(() => upstream.mockClear())
describe('preview isolation policy', () => {
  it.each(['/admin', '/admin/login', '/api/graphql', '/api/cron/ati-logistics', '/api', '/api%2Fgraphql'])('blocks protected %s before the application', async path => {
    const response = await worker.fetch(new Request('https://preview.example'+path), { LOCAL_SMTP_TEST: '1' })
    expect(response.status).toBe(404); expect(upstream).not.toHaveBeenCalled()
  })
  it.each(['https://preview.example', 'http://127.0.0.1.evil.example'])('never permits public request POST at %s, even with local flag', async origin => {
    const response = await worker.fetch(new Request(origin+'/api/request', { method: 'POST' }), { LOCAL_SMTP_TEST: '1' })
    expect(response.status).toBe(503); expect(await response.json()).toEqual({error:'Тестовая версия: заявки здесь не отправляются'}); expect(upstream).not.toHaveBeenCalled()
  })
  it('does not permit local request without explicit flag', async () => {
    expect((await worker.fetch(new Request('http://127.0.0.1/api/request', { method:'POST' }), {})).status).toBe(503)
    expect(upstream).not.toHaveBeenCalled()
  })
  it('passes a local SMTP-test POST only with the explicit flag', async () => {
    const request = new Request('http://127.0.0.1/api/request', { method: 'POST', body: 'local fixture' })
    const env = { LOCAL_SMTP_TEST: '1' }
    const response = await worker.fetch(request, env)
    expect(response.status).toBe(200); expect(upstream).toHaveBeenCalledWith(request,env,undefined)
  })
  it.each(['/', '/produkciya/listovoy-prokat/holodnokatanyj', '/api/catalog-search'])('blocks non-read methods on %s', async path => {
    expect((await worker.fetch(new Request('http://127.0.0.1'+path, { method:'POST' }), { LOCAL_SMTP_TEST:'1' })).status).toBe(405)
    expect(upstream).not.toHaveBeenCalled()
  })
  it('preserves HTML bytes while adding noindex', async () => {
    const response = await worker.fetch(new Request('https://preview.example/'), {})
    expect(response.headers.get('X-Robots-Tag')).toBe('noindex, nofollow'); expect(await response.text()).toBe('<main>approved</main>')
  })
})
