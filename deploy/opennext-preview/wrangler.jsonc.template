{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "magic-metal-stable-preview",
  "main": ".open-next/preview-worker.js",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "NEXT_PUBLIC_YANDEX_METRIKA_ID": "0"
  }
}
