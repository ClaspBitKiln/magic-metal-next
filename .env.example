DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/magicmet
PAYLOAD_SECRET=replace-with-a-long-random-secret
# Private persistent request attachments (all four required to enable S3).
# Supply real secrets in deployment settings; never commit values.
REQUEST_FILES_S3_BUCKET=
REQUEST_FILES_S3_REGION=
REQUEST_FILES_S3_ACCESS_KEY_ID=
REQUEST_FILES_S3_SECRET_ACCESS_KEY=
# Optional S3-compatible endpoint; HTTPS required in production.
REQUEST_FILES_S3_ENDPOINT=
REQUEST_FILES_S3_FORCE_PATH_STYLE=false
REQUEST_FILES_S3_SESSION_TOKEN=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SMTP delivery of new requests to m1@magicmet.ru
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
REQUEST_TO_EMAIL=m1@magicmet.ru

# Optional integrations
CRM_WEBHOOK_URL=
# Optional public counter override; default site counter is 113661397. Use 0 to disable; rebuild after changing.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
# Legacy GA4 setting is not used: one counter keeps analytics simpler and lighter.
NEXT_PUBLIC_GA4_ID=

# BicoTender API — use the exact endpoint/credentials supplied by BicoTender
BICOTENDER_API_URL=
BICOTENDER_API_TOKEN=
